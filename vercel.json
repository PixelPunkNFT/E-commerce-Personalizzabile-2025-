{
    "version": 2,
    "builds": [
        {
            "src": "backend/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/build/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/v1/(.*)",
            "dest": "backend/server.js"
        },
        {
            "src": "/static/(.*)",
            "dest": "frontend/build/static/$1"
        },
        {
            "src": "/(.+\\.\\w+)$",
            "dest": "frontend/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/build/index.html"
        }
    ]
}
